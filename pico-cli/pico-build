#!/bin/bash
#
# pico-build - Build Raspberry Pi Pico firmware
#
# Builds the firmware from source, creating blaze_pico.uf2 in the build directory.
# Performs a clean build by removing the old build folder first.
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Project root (assumes script is in pico-cli/ subdirectory)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
BUILD_DIR="$PROJECT_ROOT/build"

# Set PICO_SDK_PATH if not set
if [ -z "$PICO_SDK_PATH" ]; then
    if [ -d ~/pico-sdk ]; then
        export PICO_SDK_PATH=~/pico-sdk
    elif [ -d ~/pico/pico-sdk ]; then
        export PICO_SDK_PATH=~/pico/pico-sdk
    fi
fi

# Use official ARM toolchain if available (includes newlib)
# Check multiple locations: /tmp (temporary), ~/arm-toolchain (permanent install)
ARM_TOOLCHAIN=""
if [ -d "$HOME/arm-toolchain" ]; then
    ARM_TOOLCHAIN=$(find "$HOME/arm-toolchain" -name "arm-none-eabi-gcc" -type f 2>/dev/null | head -1)
fi
if [ -z "$ARM_TOOLCHAIN" ]; then
    ARM_TOOLCHAIN=$(find /tmp/arm-gnu-toolchain-* -name "arm-none-eabi-gcc" -type f 2>/dev/null | head -1)
fi
if [ -n "$ARM_TOOLCHAIN" ]; then
    TOOLCHAIN_BIN=$(dirname "$ARM_TOOLCHAIN")
    export PATH="$TOOLCHAIN_BIN:$PATH"
    echo "Using ARM toolchain: $TOOLCHAIN_BIN"
fi

# Set PICO_SDK_PATH if not set
if [ -z "$PICO_SDK_PATH" ]; then
    if [ -d ~/pico-sdk ]; then
        export PICO_SDK_PATH=~/pico-sdk
    elif [ -d ~/pico/pico-sdk ]; then
        export PICO_SDK_PATH=~/pico/pico-sdk
    fi
fi

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}PICO BUILD${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Check if we're in the right directory
if [ ! -f "$PROJECT_ROOT/main.c" ]; then
    echo -e "${RED}✗ Error: main.c not found in project root${NC}"
    echo "  Expected: $PROJECT_ROOT/main.c"
    exit 1
fi

# Clean build directory
echo -e "${YELLOW}Cleaning build directory...${NC}"
if [ -d "$BUILD_DIR" ]; then
    rm -rf "$BUILD_DIR"
fi
mkdir -p "$BUILD_DIR"

# Change to build directory
cd "$BUILD_DIR"

# Run cmake
echo -e "${YELLOW}Running cmake...${NC}"
if ! cmake ..; then
    echo -e "${RED}✗ CMAKE FAILED${NC}"
    exit 1
fi

# Run make
echo -e "${YELLOW}Building firmware (make -j4)...${NC}"
if ! make -j4; then
    echo -e "${RED}✗ BUILD FAILED${NC}"
    exit 1
fi

# Check if UF2 file was created
UF2_FILE="$BUILD_DIR/blaze_pico.uf2"
if [ ! -f "$UF2_FILE" ]; then
    echo -e "${RED}✗ BUILD FAILED${NC}"
    echo "  Expected UF2 file not found: $UF2_FILE"
    exit 1
fi

# Get file size for confirmation
FILE_SIZE=$(stat -f%z "$UF2_FILE" 2>/dev/null || stat -c%s "$UF2_FILE" 2>/dev/null)
FILE_SIZE_KB=$((FILE_SIZE / 1024))

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✓ BUILD SUCCESS${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo "  UF2 file: $UF2_FILE"
echo "  Size: ${FILE_SIZE_KB} KB"
echo ""
