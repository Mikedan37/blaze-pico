#!/bin/bash
#
# pico-monitor - Open serial monitor for Raspberry Pi Pico
#
# Auto-detects the correct serial device and launches screen.
# Supports log persistence with --log flag.
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

BAUD_RATE=115200
LOG_ENABLED=false
LOG_DIR="$HOME/pico/logs"
SPECIFIC_DEVICE=""

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --log)
            LOG_ENABLED=true
            shift
            ;;
        --device)
            SPECIFIC_DEVICE="$2"
            shift 2
            ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
done

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}PICO MONITOR${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Find serial devices
if [ -n "$SPECIFIC_DEVICE" ]; then
    SERIAL_DEVICE="$SPECIFIC_DEVICE"
    if [ ! -e "$SERIAL_DEVICE" ]; then
        echo -e "${RED}✗ Device not found: $SERIAL_DEVICE${NC}"
        exit 1
    fi
else
    SERIAL_DEVICES=($(ls /dev/cu.usbmodem* 2>/dev/null | sort))
    
    if [ ${#SERIAL_DEVICES[@]} -eq 0 ]; then
        echo -e "${RED}✗ NO SERIAL DEVICE FOUND${NC}"
        echo ""
        echo "  No /dev/cu.usbmodem* devices detected."
        echo "  Make sure Pico is connected and not in BOOTSEL mode."
        exit 1
    fi
    
    # If multiple devices, choose the newest (last in sorted list)
    # Use compatible array indexing for older bash versions
    LAST_INDEX=$((${#SERIAL_DEVICES[@]} - 1))
    SERIAL_DEVICE="${SERIAL_DEVICES[$LAST_INDEX]}"
    
    if [ ${#SERIAL_DEVICES[@]} -gt 1 ]; then
        echo -e "${YELLOW}Multiple serial devices found:${NC}"
        for dev in "${SERIAL_DEVICES[@]}"; do
            if [ "$dev" == "$SERIAL_DEVICE" ]; then
                echo -e "  ${GREEN}→ $dev${NC} (using this one)"
            else
                echo -e "    $dev"
            fi
        done
        echo ""
    else
        echo -e "${GREEN}Serial device: $SERIAL_DEVICE${NC}"
        echo ""
    fi
fi

# Setup logging if enabled
LOG_FILE=""
if [ "$LOG_ENABLED" = true ]; then
    mkdir -p "$LOG_DIR"
    DATE_STR=$(date +%Y%m%d_%H%M%S)
    LOG_FILE="$LOG_DIR/pico_${DATE_STR}.log"
    echo -e "${GREEN}✓ Logging enabled: $LOG_FILE${NC}"
    echo ""
fi

# Check if screen is available
if ! command -v screen &> /dev/null; then
    echo -e "${RED}✗ SCREEN NOT FOUND${NC}"
    echo ""
    echo "  'screen' command is required for serial monitoring."
    echo "  Install with: brew install screen"
    exit 1
fi

# Instructions
echo -e "${YELLOW}Opening serial monitor...${NC}"
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}Serial Monitor${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━DEVICE: $SERIAL_DEVICE"
echo "  Baud: $BAUD_RATE"
if [ -n "$LOG_FILE" ]; then
    echo "  Log: $LOG_FILE"
fi
echo ""
echo -e "${YELLOW}To exit:${NC}"
echo "  Press: CTRL+A, then K, then Y"
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Launch screen with optional logging
if [ -n "$LOG_FILE" ]; then
    # Use screen with logging via script command
    # Screen doesn't natively support logging, so we use a wrapper
    exec screen -L -Logfile "$LOG_FILE" "$SERIAL_DEVICE" "$BAUD_RATE"
else
    exec screen "$SERIAL_DEVICE" "$BAUD_RATE"
fi
