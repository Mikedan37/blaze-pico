#!/bin/bash
#
# pico-flash - Flash firmware to Raspberry Pi Pico
#
# Locates the UF2 file, waits for Pico mount, and flashes the firmware.
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Project root (assumes script is in pico-cli/ subdirectory)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
BUILD_DIR="$PROJECT_ROOT/build"

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}PICO FLASH${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Find UF2 file (newest if multiple exist)
UF2_FILE=""
if [ -d "$BUILD_DIR" ]; then
    # Look for UF2 files in build directory
    UF2_FILE=$(find "$BUILD_DIR" -name "*.uf2" -type f -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null | head -1)
fi

if [ -z "$UF2_FILE" ] || [ ! -f "$UF2_FILE" ]; then
    echo -e "${RED}✗ NO UF2 FOUND${NC}"
    echo ""
    echo "  Expected location: $BUILD_DIR/*.uf2"
    echo ""
    echo "  Run 'pico-build' first to build the firmware."
    exit 1
fi

echo -e "${YELLOW}UF2 file: $UF2_FILE${NC}"
FILE_SIZE=$(stat -f%z "$UF2_FILE" 2>/dev/null || stat -c%s "$UF2_FILE" 2>/dev/null)
FILE_SIZE_KB=$((FILE_SIZE / 1024))
echo -e "${YELLOW}Size: ${FILE_SIZE_KB} KB${NC}"
echo ""

# Wait for Pico mount (call pico-wait internally)
echo -e "${YELLOW}Waiting for Pico mount...${NC}"
MOUNT_PATH=""
MOUNT_NAMES=("RP2350" "RPI-RP2")
MOUNT_BASE="/Volumes"

check_mount() {
    for mount_name in "${MOUNT_NAMES[@]}"; do
        MOUNT_CHECK="$MOUNT_BASE/$mount_name"
        if [ -d "$MOUNT_CHECK" ]; then
            if mountpoint -q "$MOUNT_CHECK" 2>/dev/null || [ -f "$MOUNT_CHECK/INDEX.HTM" ] || [ -f "$MOUNT_CHECK/INFO_UF2.TXT" ]; then
                echo "$MOUNT_CHECK"
                return 0
            fi
        fi
    done
    return 1
}

# Poll for mount
POLL_INTERVAL=0.5
MAX_WAIT=60
START_TIME=$(date +%s)

while true; do
    CURRENT_TIME=$(date +%s)
    ELAPSED=$((CURRENT_TIME - START_TIME))
    
    if [ $ELAPSED -ge $MAX_WAIT ]; then
        echo -e "${RED}✗ TIMEOUT${NC}"
        echo "  No Pico detected after ${MAX_WAIT} seconds"
        echo "  Make sure to hold BOOTSEL and plug in USB"
        exit 1
    fi
    
    if MOUNT_PATH=$(check_mount); then
        break
    fi
    
    printf "\r${YELLOW}Waiting for mount... (${ELAPSED}s)${NC}"
    sleep $POLL_INTERVAL
done

echo ""
echo -e "${GREEN}✓ Pico detected at: $MOUNT_PATH${NC}"
echo ""

# Calculate local file checksum (MD5)
echo -e "${YELLOW}Calculating checksum...${NC}"
LOCAL_CHECKSUM=$(md5 -q "$UF2_FILE" 2>/dev/null || md5sum "$UF2_FILE" 2>/dev/null | cut -d' ' -f1)
LOCAL_SIZE=$(stat -f%z "$UF2_FILE" 2>/dev/null || stat -c%s "$UF2_FILE" 2>/dev/null)

echo -e "${YELLOW}  Local checksum: $LOCAL_CHECKSUM${NC}"
echo -e "${YELLOW}  Local size: $LOCAL_SIZE bytes${NC}"
echo ""

# Copy UF2 file
echo -e "${YELLOW}Copying UF2 file...${NC}"
UF2_NAME=$(basename "$UF2_FILE")
DEST_PATH="$MOUNT_PATH/$UF2_NAME"

if ! cp "$UF2_FILE" "$DEST_PATH"; then
    echo -e "${RED}✗ COPY FAILED${NC}"
    echo "  Failed to copy $UF2_FILE to $DEST_PATH"
    exit 1
fi

# Sync to ensure write completes
echo -e "${YELLOW}Syncing...${NC}"
sync

# Verify file was copied
if [ ! -f "$DEST_PATH" ]; then
    echo -e "${RED}✗ VERIFICATION FAILED${NC}"
    echo "  File not found at destination: $DEST_PATH"
    exit 1
fi

# Verify file size matches
DEST_SIZE=$(stat -f%z "$DEST_PATH" 2>/dev/null || stat -c%s "$DEST_PATH" 2>/dev/null)
if [ "$LOCAL_SIZE" != "$DEST_SIZE" ]; then
    echo -e "${RED}✗ SIZE MISMATCH${NC}"
    echo "  Local: $LOCAL_SIZE bytes"
    echo "  Copied: $DEST_SIZE bytes"
    exit 1
fi

# Verify checksum matches (if md5 available on mounted volume)
echo -e "${YELLOW}Verifying checksum...${NC}"
DEST_CHECKSUM=$(md5 -q "$DEST_PATH" 2>/dev/null || md5sum "$DEST_PATH" 2>/dev/null | cut -d' ' -f1 || echo "")

if [ -n "$DEST_CHECKSUM" ] && [ "$LOCAL_CHECKSUM" != "$DEST_CHECKSUM" ]; then
    echo -e "${RED}✗ CHECKSUM MISMATCH${NC}"
    echo "  Local: $LOCAL_CHECKSUM"
    echo "  Copied: $DEST_CHECKSUM"
    exit 1
fi

if [ -n "$DEST_CHECKSUM" ]; then
    echo -e "${GREEN}✓ Checksum verified: $DEST_CHECKSUM${NC}"
fi

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✓ FLASH COMPLETE${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo "  Firmware flashed to: $MOUNT_PATH"
echo "  Pico will reboot automatically"
echo ""
