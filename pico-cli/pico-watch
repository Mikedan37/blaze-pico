#!/bin/bash
#
# pico-watch - Live rebuild + auto flash watch mode
#
# Watches firmware source files, automatically rebuilds and flashes on changes.
# Professional embedded dev workflow: edit → save → auto-flash
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Project root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Check if fswatch is available
if ! command -v fswatch &> /dev/null; then
    echo -e "${RED}✗ FSWATCH NOT FOUND${NC}"
    echo ""
    echo "  'fswatch' is required for file watching."
    echo "  Install with: brew install fswatch"
    exit 1
fi

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}PICO WATCH${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "${YELLOW}Watching for file changes...${NC}"
echo -e "${YELLOW}Press CTRL+C to stop${NC}"
echo ""

# Files/directories to watch
WATCH_PATHS=(
    "$PROJECT_ROOT/main.c"
    "$PROJECT_ROOT/CMakeLists.txt"
    "$PROJECT_ROOT/pico_sdk_import.cmake"
)

# Find all .c and .h files
while IFS= read -r -d '' file; do
    WATCH_PATHS+=("$file")
done < <(find "$PROJECT_ROOT" -type f \( -name "*.c" -o -name "*.h" -o -name "*.cmake" \) -print0 2>/dev/null)

# Track last build time to prevent rapid rebuilds
LAST_BUILD=0
DEBOUNCE_SECONDS=2

# Watch loop
fswatch -0 "${WATCH_PATHS[@]}" | while IFS= read -r -d '' event; do
    CURRENT_TIME=$(date +%s)
    
    # Debounce: don't rebuild if last build was too recent
    if [ $((CURRENT_TIME - LAST_BUILD)) -lt $DEBOUNCE_SECONDS ]; then
        continue
    fi
    
    LAST_BUILD=$CURRENT_TIME
    
    echo ""
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}File changed: $(basename "$event")${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    
    # Build
    echo -e "${YELLOW}[1/3] Building...${NC}"
    if ! "$SCRIPT_DIR/pico-build" > /dev/null 2>&1; then
        echo -e "${RED}✗ Build failed${NC}"
        continue
    fi
    echo -e "${GREEN}✓ Build complete${NC}"
    echo ""
    
    # Flash (using pico-flash)
    echo -e "${YELLOW}[2/3] Flashing...${NC}"
    echo -e "${YELLOW}Hold BOOTSEL + Plug in USB${NC}"
    
    # Use pico-flash (waits for mount automatically)
    if ! "$SCRIPT_DIR/pico-flash" > /dev/null 2>&1; then
        echo -e "${RED}✗ Flash failed${NC}"
        continue
    fi
    
    echo -e "${GREEN}✓ Flash complete${NC}"
    echo ""
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}✓ Rebuild and flash complete${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "${YELLOW}Watching for changes...${NC}"
done
